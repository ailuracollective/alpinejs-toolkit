# Base URLs for links that cross between the two apps and the repository.
#
# Every value below is OPTIONAL. Each one defaults to the URL that was
# hardcoded before these variables existed, so a fresh clone builds, tests and
# runs with no .env at all. Set one only when a deploy genuinely needs to
# differ — a fork, a preview deployment, a staging docs site.
#
# Trailing slashes are stripped on read, so both forms work.
#
# The `PUBLIC_` prefix is Astro's marker for values that reach the browser
# bundle. These are not secrets, and nothing sensitive belongs in this file.
#
# Copy to `.env` in the app's directory to use it. `.env` is gitignored.

# The GitHub repository, without a trailing slash.
# Default: https://github.com/ailuracollective/alpinejs-toolkit
PUBLIC_REPO_URL=

# The docs site. This is what ends up in canonical URLs and the sitemap.
# Default: https://ailuracollective.github.io/alpinejs-toolkit
PUBLIC_DOCS_URL=

# The demo site.
# Default: https://ailura.dev
PUBLIC_DEMO_URL=
