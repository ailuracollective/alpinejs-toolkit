{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["astro/client", "alpinejs"],
    "paths": {
      "@/*": ["./src/*"],
      "@ailura/alpinejs-accordion": ["../../packages/accordion/src/index.ts"],
      "@ailura/alpinejs-attention": ["../../packages/attention/src/index.ts"],
      "@ailura/alpinejs-calendar": ["../../packages/calendar/src/index.ts"],
      "@ailura/alpinejs-carousel": ["../../packages/carousel/src/index.ts"],
      "@ailura/alpinejs-child": ["../../packages/child/src/index.ts"],
      "@ailura/alpinejs-collection": ["../../packages/collection/src/index.ts"],
      "@ailura/alpinejs-command": ["../../packages/command/src/index.ts"],
      "@ailura/alpinejs-core": ["../../packages/core/src/index.ts"],
      "@ailura/alpinejs-core/bridge": ["../../packages/core/src/bridge.ts"],
      "@ailura/alpinejs-core/constants": ["../../packages/core/src/constants.ts"],
      "@ailura/alpinejs-core/controller": ["../../packages/core/src/controller.ts"],
      "@ailura/alpinejs-core/directives": ["../../packages/core/src/directives.ts"],
      "@ailura/alpinejs-core/env": ["../../packages/core/src/env.ts"],
      "@ailura/alpinejs-core/errors": ["../../packages/core/src/errors.ts"],
      "@ailura/alpinejs-core/guards": ["../../packages/core/src/guards.ts"],
      "@ailura/alpinejs-core/ids": ["../../packages/core/src/ids.ts"],
      "@ailura/alpinejs-core/invariant": ["../../packages/core/src/invariant.ts"],
      "@ailura/alpinejs-core/registration": ["../../packages/core/src/registration.ts"],
      "@ailura/alpinejs-core/singletons": ["../../packages/core/src/singletons.ts"],
      "@ailura/alpinejs-core/sync": ["../../packages/core/src/sync.ts"],
      "@ailura/alpinejs-dialog": ["../../packages/dialog/src/index.ts"],
      "@ailura/alpinejs-env": ["../../packages/env/src/index.ts"],
      "@ailura/alpinejs-form": ["../../packages/form/src/index.ts"],
      "@ailura/alpinejs-geo": ["../../packages/geo/src/index.ts"],
      "@ailura/alpinejs-gesture": ["../../packages/gesture/src/index.ts"],
      "@ailura/alpinejs-history": ["../../packages/history/src/index.ts"],
      "@ailura/alpinejs-json-api": ["../../packages/json-api/src/index.ts"],
      "@ailura/alpinejs-keyboard": ["../../packages/keyboard/src/index.ts"],
      "@ailura/alpinejs-lang": ["../../packages/lang/src/index.ts"],
      "@ailura/alpinejs-media": ["../../packages/media/src/index.ts"],
      "@ailura/alpinejs-menu": ["../../packages/menu/src/index.ts"],
      "@ailura/alpinejs-notify": ["../../packages/notify/src/index.ts"],
      "@ailura/alpinejs-overlay": ["../../packages/overlay/src/index.ts"],
      "@ailura/alpinejs-permissions": ["../../packages/permissions/src/index.ts"],
      "@ailura/alpinejs-plugin-template": ["../../packages/plugin-template/src/index.ts"],
      "@ailura/alpinejs-query": ["../../packages/query/src/index.ts"],
      "@ailura/alpinejs-query-adapter-alpine": ["../../packages/query-adapter-alpine/src/index.ts"],
      "@ailura/alpinejs-query-adapter-zustand": [
        "../../packages/query-adapter-zustand/src/index.ts"
      ],
      "@ailura/alpinejs-query-adapter-nanostores": [
        "../../packages/query-adapter-nanostores/src/index.ts"
      ],
      "@ailura/alpinejs-query/devtools": ["../../packages/query/src/devtools.ts"],
      "@ailura/alpinejs-scroll": ["../../packages/scroll/src/index.ts"],
      "@ailura/alpinejs-selection": ["../../packages/selection/src/index.ts"],
      "@ailura/alpinejs-sidebar": ["../../packages/sidebar/src/index.ts"],
      "@ailura/alpinejs-state-machine": ["../../packages/state-machine/src/index.ts"],
      "@ailura/alpinejs-tabs": ["../../packages/tabs/src/index.ts"],
      "@ailura/alpinejs-testing": ["../../packages/testing/src/index.ts"],
      "@ailura/alpinejs-testing/mock": ["../../packages/testing/src/mock.ts"],
      "@ailura/alpinejs-theme": ["../../packages/theme/src/index.ts"],
      "@ailura/alpinejs-timer": ["../../packages/timer/src/index.ts"],
      "@ailura/alpinejs-toast": ["../../packages/toast/src/index.ts"],
      "@ailura/alpinejs-tooltip": ["../../packages/tooltip/src/index.ts"],
      "@ailura/alpinejs-transfer": ["../../packages/transfer/src/index.ts"],
      "@ailura/alpinejs-ui": ["../../packages/ui/src/index.ts"],
      "@ailura/alpinejs-ui/media": ["../../packages/ui/src/media.ts"],
      "@ailura/alpinejs-ui/portal": ["../../packages/ui/src/portal.ts"],
      "@ailura/alpinejs-ui/storage": ["../../packages/ui/src/storage.ts"],
      "@ailura/alpinejs-ui/types": ["../../packages/ui/src/types.ts"],
      "@ailura/alpinejs-virtual": ["../../packages/virtual/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
