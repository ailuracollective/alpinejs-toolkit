---
import { getPluginNavItem } from "../../plugin-nav";
import DemoButton from "../astro/DemoButton.astro";
import DemoExample from "../DemoExample.astro";
import DemoSection from "../DemoSection.astro";

const plugin = getPluginNavItem("virtual")!;
const scrollViewport = "h-64 overflow-auto rounded-lg border";
const rowClass = "absolute left-0 top-0 flex w-full items-center border-b px-3 text-sm";

const FIXED_CODE = `<!-- The viewport. .create does both things: it creates the instance
     from these options and binds THIS element as the scroll container.
     Its cleanup() releases the listener when Alpine removes the element. -->
<div
  x-virtual-scroll.create="{
    id: 'fixed',
    count: fixedRows.length,
    estimateSize: 36,
    overscan: 6,
  }"
  class="h-64 overflow-auto rounded-lg border"
  x-bind="$store.virtual.listProps('fixed', { label: 'Fixed virtual list' })"
>
  <!-- The spacer: SYNTHESIZED height = the sum of the 10,000 rows.
       The scrollbar is correct before a single row has been painted. -->
  <div
    :style="contentStyle('fixed')"
    x-bind="$store.virtual.contentProps('fixed')"
  >
    <template
      x-for="item in $store.virtual.instances.fixed?.virtualItems ?? []"
      :key="item.key"
    >
      <!-- translateY(item.start) is what puts the row in its place;
           height: item.size is what makes the spacer add up. -->
      <div
        x-bind="$store.virtual.itemProps('fixed', item.index)"
        class="absolute left-0 top-0 flex w-full items-center border-b px-3 text-sm"
        :style="itemStyle('fixed', item.index)"
        x-text="fixedRows[item.index].label"
      ></div>
    </template>
  </div>
</div>

<button @click="$store.virtual.scrollToIndex('fixed', 0)">Top</button>
<button @click="$store.virtual.scrollToIndex('fixed', 4999, { align: 'center' })">Middle</button>
<button @click="$store.virtual.scrollToIndex('fixed', fixedRows.length - 1, { align: 'end' })">Bottom</button>

<!-- The bare identifier IS the id: do not put it in quotes.
     x-virtual-scroll="rows" is evaluated as an expression and asks for a
     VARIABLE called rows — which does not exist — and the list stays dead
     without an error. -->`;

const VARIABLE_CODE = `<!-- Here the container is measured, so the instance is created by a
     separate create(): the directive's .create cannot call measureItem for
     every row. -->
<div
  x-init="(() => {
    $store.virtual.create('variable', {
      count: variableRows.length,
      estimateSize: 40,
      overscan: 4,
      // Without getItemKey the rows are identified by index, and a measurement
      // does not survive a reorder.
      getItemKey: (index) => variableRows[index].id,
    });
    variableRows.forEach((row, index) =>
      $store.virtual.measureItem('variable', index, row.height)
    );
  })()"
>
  <div
    x-virtual-scroll="variable"
    class="h-64 overflow-auto rounded-lg border"
    x-bind="$store.virtual.listProps('variable', { label: 'Variable virtual list' })"
  >
    <div :style="contentStyle('variable')" x-bind="$store.virtual.contentProps('variable')">
      <template
        x-for="item in $store.virtual.instances.variable?.virtualItems ?? []"
        :key="item.key"
      >
        <div
          x-bind="$store.virtual.itemProps('variable', item.index)"
          class="absolute left-0 top-0 flex w-full items-center border-b px-3 text-sm"
          :style="itemStyle('variable', item.index)"
          x-text="variableRows[item.index].label"
        ></div>
      </template>
    </div>
  </div>
</div>

<!-- Careful: the x-init is wrapped in an IIFE on purpose. Alpine compiles
     x-init as \`let __result = <expression>\`, so with several statements only
     the first one lands in __result — and a registration function returns its
     unregister, which Alpine would then call as if it were the result.
     measureItem() returns undefined, but the IIFE does not rely on that. -->

<!-- measureItem() THROWS with size <= 0 and with an out-of-range index, so
     only measure rows that really exist. And remember: the package does not
     observe sizes. Whatever you do not measure stays at estimateSize
     forever. -->`;
---

<DemoSection id={plugin.id} title={plugin.title} api={plugin.api} description={plugin.description}>
	<p class="text-sm text-[var(--ios-label-secondary)] text-pretty">
		The package computes <em>which</em> rows to paint and <em>where</em>; it never
		touches a row. A virtualized list is three attributes and a spacer — the
		container with <code>x-virtual-scroll</code>, the spacer with the total height,
		and a <code>translateY</code> per row.
	</p>

	<div
		class="grid min-w-0 gap-6"
		x-data="{
			fixedRows: Array.from({ length: 10000 }, (_, i) => ({ id: i, label: `Row ${i + 1}` })),
			variableRows: Array.from({ length: 200 }, (_, i) => ({
				id: `v-${i}`,
				label: `Variable row ${i + 1}`,
				height: 28 + ((i * 17) % 48),
			})),
			stateLine(id) {
				const s = $store.virtual.instances[id];
				if (!s) return '—';
				return `${s.virtualItems.length} rendered of ${s.options.count} · range ${s.startIndex}–${s.endIndex} · ${s.totalSize}px of scroll height`;
			},
			itemStyle(id, index) {
				const item = ($store.virtual.instances[id]?.virtualItems ?? []).find((entry) => entry.index === index);
				if (!item) return '';
				return `transform: translateY(${item.start}px); height: ${item.size}px`;
			},
			contentStyle(id) {
				const total = $store.virtual.instances[id]?.totalSize ?? 0;
				return `position: relative; height: ${total}px; width: 100%`;
			},
		}"
	>
		<DemoExample
			title="10,000 rows, a handful in the DOM"
			note="This is the case the library exists for: a data table that cannot have 10,000 nodes. The scroll height comes from count × estimateSize before a single row exists, so the scrollbar is right from the first frame."
			open
			code={FIXED_CODE}
		>
			<div class="min-w-0">
				<p class="text-xs text-[var(--ios-label-secondary)] mb-3" x-text="stateLine('fixed')"></p>
				<div
					x-virtual-scroll.create="{ id: 'fixed', count: fixedRows.length, estimateSize: 36, overscan: 6 }"
					class={scrollViewport}
					x-bind="$store.virtual.listProps('fixed', { label: 'Fixed virtual list' })"
				>
					<div :style="contentStyle('fixed')" x-bind="$store.virtual.contentProps('fixed')">
						<template x-for="item in $store.virtual.instances.fixed?.virtualItems ?? []" :key="item.key" data-testid="virtual-items">
							<div
								x-bind="$store.virtual.itemProps('fixed', item.index)"
								class={rowClass}
								:style="itemStyle('fixed', item.index)"
								x-text="fixedRows[item.index].label"
							></div>
						</template>
					</div>
				</div>
				<div class="mt-3 flex flex-wrap gap-2">
					<DemoButton size="sm" @click="$store.virtual.scrollToIndex('fixed', 0)">Top</DemoButton>
					<DemoButton size="sm" @click="$store.virtual.scrollToIndex('fixed', 4999, { align: 'center' })">Middle</DemoButton>
					<DemoButton size="sm" @click="$store.virtual.scrollToIndex('fixed', fixedRows.length - 1, { align: 'end' })">Bottom</DemoButton>
				</div>
			</div>
		</DemoExample>

		<DemoExample
			title="Rows of different heights: you have to measure them"
			note="The package does not observe sizes — there is no ResizeObserver. Whatever you do not measure stays at estimateSize forever, and the scrollbar drifts off. That is the real cost of this kind of list."
			open
			code={VARIABLE_CODE}
		>
			<div class="min-w-0">
				<p class="text-xs text-[var(--ios-label-secondary)] mb-3" x-text="stateLine('variable')"></p>
				<div
					x-init="(() => {
						$store.virtual.create('variable', {
							count: variableRows.length,
							estimateSize: 40,
							overscan: 4,
							getItemKey: (index) => variableRows[index].id,
						});
						variableRows.forEach((row, index) => $store.virtual.measureItem('variable', index, row.height));
					})()"
				>
					<div
						x-virtual-scroll="variable"
						class={scrollViewport}
						x-bind="$store.virtual.listProps('variable', { label: 'Variable virtual list' })"
					>
						<div :style="contentStyle('variable')" x-bind="$store.virtual.contentProps('variable')">
							<template x-for="item in $store.virtual.instances.variable?.virtualItems ?? []" :key="item.key">
								<div
									x-bind="$store.virtual.itemProps('variable', item.index)"
									class={rowClass}
									:style="itemStyle('variable', item.index)"
									x-text="variableRows[item.index].label"
								></div>
							</template>
						</div>
					</div>
				</div>
			</div>
		</DemoExample>
	</div>
</DemoSection>
