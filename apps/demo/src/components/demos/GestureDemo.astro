---
import { getPluginNavItem } from "../../plugin-nav";
import Badge from "../astro/Badge.astro";
import DemoExample from "../DemoExample.astro";
import DemoSection from "../DemoSection.astro";

const plugin = getPluginNavItem("gesture")!;

// The real x-data and the real directives of the surface below it.
const GESTURES_CODE = `x-data="{
  lastGesture: 'none',
  panX: 0,
  panY: 0,
  // The handler is called with the gesture detail as its first argument and
  // with this scope as \`this\` — the same contract as \`x-on:click="handler"\`.
  handleTap() { this.lastGesture = 'tap' },
  handleDoubleTap() { this.lastGesture = 'doubletap' },
  handleLongPress() { this.lastGesture = 'longpress' },
  handleSwipe(d) { this.lastGesture = 'swipe ' + d.direction },
  handlePan(d) {
    this.panX = d.distanceX
    this.panY = d.distanceY
    this.lastGesture = d.phase === 'end' ? 'pan end' : 'pan ' + d.phase
  },
}"

// touch-none is load-bearing, not decoration: without it the browser claims
// the pointer for its own pan/zoom and the recogniser never sees the drag.
<div
  x-gesture.tap="handleTap"
  x-gesture.doubletap="handleDoubleTap"
  x-gesture.longpress="handleLongPress"
  x-gesture.swipe="handleSwipe"
  x-gesture.pan="handlePan"
  class="flex h-40 touch-none select-none items-center justify-center"
>
  Interact here
</div>

<span x-text="lastGesture"></span>

// Two things that bite before you wire these up:
//
// · \`pan\` and \`swipe\` are NOT alternatives on the same drag. A fast long
//   flick clears the pan threshold on the way and the swipe threshold on
//   release, so one drag emits pan (start/move/end) and then swipe — and
//   lastGesture ends on 'swipe up' rather than 'pan end'.
// · a second tap is emitted as \`doubletap\` and NOT as a second \`tap\`, so
//   handleTap runs once for a double tap, not twice.
//
// Nothing here is cancelled for you: no pointer event is ever suppressed, so
// touch-action: none is still your job. The wheel is the one exception, and it
// takes the \`.prevent\` modifier rather than an option.`;

const PINCH_CODE = `x-data="{
  lastGesture: 'none',
  pinchScale: 1,
  pinchOrigin: 1,
  handlePinch(d) {
    // d.phase is 'start' | 'move' | 'end'. The controller resets scale back to
    // 1 when the last finger lifts, so without a value committed here the zoom
    // could never accumulate across two pinches.
    if (d.phase === 'end') {
      this.pinchOrigin = this.pinchScale
      this.lastGesture = 'pinch end'
      return
    }
    const scale = d.scale ?? 1
    this.pinchScale = Math.min(3, Math.max(0.5, this.pinchOrigin * scale))
    this.lastGesture = scale > 1 ? 'pinch zoom in' : scale < 1 ? 'pinch zoom out' : 'pinch start'
  },
}"

<div x-gesture.pinch="handlePinch" class="flex h-40 touch-none select-none overflow-hidden">
  <div :style="'transform: scale(' + pinchScale + ')'">
    ×<span x-text="pinchScale.toFixed(2)"></span>
  </div>
</div>

// \`$store.gesture\` mirrors whichever surface is being touched right now, so a
// second surface on the same page does not fight this one for it.
$store.gesture.active         // true while a pointer is down
$store.gesture.kind           // 'pinch'
$store.gesture.pointerCount   // 2
$store.gesture.scale
$store.gesture.cancel();      // aborts the interaction in progress`;

const WHEEL_CODE = `x-data="{
  zoom: 1,
  // The zoom committed by the previous wheel session. The recognizer
  // accumulates a scale within one session and resets it to 1 after
  // wheelIdleDelay of silence, so without a carried-over base every Ctrl+wheel
  // turn would start again from 1.
  base: 1,
  ox: 50,
  oy: 50,
  handleWheel(d) {
    // The anchor is measured against the element that is transformed, so it
    // has to be #frame and not #surface — the gesture is on the surface, but
    // the scale is applied to the box inside it. In percent, too: px would go
    // stale as soon as the box changes size.
    const r = this.$refs.frame.getBoundingClientRect()
    this.ox = ((d.x - r.left) / r.width) * 100
    this.oy = ((d.y - r.top) / r.height) * 100
  },
}"

// Two effects because there is no 'end' event for a wheel: the session ending
// is an absence of input. While the session runs, scale is the live zoom; the
// moment it is gone, the zoom you are looking at becomes the next base.
x-effect="if (\u0024store.gesture.kind === 'wheel') zoom = base * \u0024store.gesture.scale"
x-effect="if (!\u0024store.gesture.active) base = zoom"

<div x-ref="surface" x-gesture.wheel.prevent="handleWheel" class="flex h-40 touch-none select-none items-center justify-center overflow-hidden rounded-md border-2 border-dashed">
  <!-- Not transformed, and the same size as the box below: measuring it gives
       the untransformed geometry that transform-origin resolves against. -->
  <div x-ref="frame" class="flex h-24 w-40 items-center justify-center">
    <div x-bind:style="{ transform: 'scale(' + zoom + ')', transformOrigin: ox + '% ' + oy + '%' }" class="flex h-24 w-40 items-center justify-center rounded-md border">
      <span x-text="'×' + zoom.toFixed(2)"></span>
    </div>
  </div>
</div>

<span x-text="'zoom ×' + zoom.toFixed(2)"></span>

// Two modifiers, and they do different jobs. \`wheel\` is the opt-in: without it
// no wheel listener is attached at all. \`prevent\` makes that listener
// non-passive, which is what lets the surface take the browser's own Ctrl+wheel
// zoom away from the page — a passive listener cannot cancel anything, so
// without it the page zooms instead of the box.
//
// Only Ctrl+wheel is recognized. A plain wheel is the user scrolling, so it
// reaches the browser untouched and the page scrolls as usual, over this box
// as much as anywhere else. A trackpad pinch arrives on this same path,
// because browsers report it as a wheel with ctrlKey set.
//
// The recognizer owns the math — d.scale is exp(-ΣdeltaY × wheelScaleFactor)
// accumulated over the session — and this demo only has to apply it.`;
---

<DemoSection id={plugin.id} title={plugin.title} api={plugin.api} description={plugin.description}>
	<DemoExample
		title="One surface, five gestures — and they are not exclusive"
		note="Each `x-gesture.<kind>` is one binding on one element, and several can share it: they all land on the same per-element recognizer, so binding five costs five attributes, not five controllers. Reach for this instead of raw `pointerdown`/`pointermove` when you want tap-vs-drag-vs-flick resolved for you."
		open
		code={GESTURES_CODE}
	>
		<div
			x-data="{
				lastGesture: 'none',
				panX: 0,
				panY: 0,
				handleTap() { this.lastGesture = 'tap' },
				handleDoubleTap() { this.lastGesture = 'doubletap' },
				handleLongPress() { this.lastGesture = 'longpress' },
				handleSwipe(d) { this.lastGesture = 'swipe ' + d.direction },
				handlePan(d) {
					this.panX = d.distanceX
					this.panY = d.distanceY
					this.lastGesture = d.phase === 'end' ? 'pan end' : 'pan ' + d.phase
				},
			}"
			class="rounded-lg border bg-[var(--ios-bg-secondary)] p-6"
			data-testid="gesture-surface"
		>
			<p class="text-sm font-medium mb-4">
				Each box is its own surface. Try a tap, a double tap, a long press, a
				swipe, or a drag on the first one.
			</p>

			<div
				x-gesture.tap="handleTap"
				x-gesture.doubletap="handleDoubleTap"
				x-gesture.longpress="handleLongPress"
				x-gesture.swipe="handleSwipe"
				x-gesture.pan="handlePan"
				class="flex h-40 touch-none select-none items-center justify-center rounded-md border-2 border-dashed text-center text-sm text-[var(--ios-label-secondary)]"
			>
				Interact here
			</div>

			<div class="mt-3 flex flex-wrap items-center gap-2">
				<span class="text-sm">Last:</span>
				<Badge
					variant="outline"
					x-text="lastGesture"
				></Badge>
				<template x-if="lastGesture.startsWith('pan ')">
					<span class="text-xs text-[var(--ios-label-secondary)] flex flex-col gap-0.5">
						<span>dx=<span x-text="panX.toFixed(1)"></span></span>
						<span>dy=<span x-text="panY.toFixed(1)"></span></span>
					</span>
				</template>
			</div>

			<p class="mt-3 text-xs text-[var(--ios-label-secondary)]">
				<code>pan</code> and <code>swipe</code> are not alternatives: a fast long flick
				clears the pan threshold on the way and the swipe threshold on release, so one
				drag fires both and the badge above ends on <code>swipe …</code>. And a second
				tap is emitted as <code>doubletap</code>, not as a second <code>tap</code> — a
				<code>tap</code> handler runs once for a double tap.
			</p>
		</div>
	</DemoExample>

	<DemoExample
		title="Pinch scales from the value committed at the previous pinch end"
		note="The recognizer hands you a `scale` relative to the current gesture, and resets it to 1 on release — the accumulated zoom is yours to keep. The trailing readout is `$store.gesture`, which is how you show gesture state outside the surface that is being touched."
		code={PINCH_CODE}
	>
		<div
			x-data="{
				lastGesture: 'none',
				pinchScale: 1,
				pinchOrigin: 1,
				handlePinch(d) {
					if (d.phase === 'end') {
						this.pinchOrigin = this.pinchScale
						this.lastGesture = 'pinch end'
						return
					}
					const scale = d.scale ?? 1
					this.pinchScale = Math.min(3, Math.max(0.5, this.pinchOrigin * scale))
					this.lastGesture = scale > 1 ? 'pinch zoom in' : scale < 1 ? 'pinch zoom out' : 'pinch start'
				}
			}"
			class="rounded-lg border bg-[var(--ios-bg-secondary)] p-6"
		>
			<p class="text-sm font-medium mb-4">
				Now the second surface: two fingers to zoom, and a second finger's
				down/up keeps the store pointed at this one.
			</p>
			<div
				x-gesture.pinch="handlePinch"
				class="flex h-40 touch-none select-none items-center justify-center overflow-hidden rounded-md border-2 border-dashed"
			>
				<div
					class="flex h-24 w-24 items-center justify-center rounded-md border bg-[var(--ios-fill-quaternary)] text-xs text-[var(--ios-label-secondary)]"
					:style="'transform: scale(' + pinchScale + ')'"
				>
					<span x-text="'×' + pinchScale.toFixed(2)"></span>
				</div>
			</div>

			<div class="mt-3 flex flex-wrap items-center gap-2">
				<span class="text-sm">Last:</span>
				<Badge
					variant="outline"
					x-text="lastGesture"
				></Badge>
			</div>

			<p class="mt-3 text-xs text-[var(--ios-label-secondary)]">
				<code>$store.gesture</code> follows the surface in use: active
				<span x-text="$store.gesture.active"></span>, kind
				<span x-text="$store.gesture.kind"></span>, fingers
				<span x-text="$store.gesture.pointerCount"></span>, scale
				<span x-text="$store.gesture.scale.toFixed(2)"></span>.
			</p>
		</div>
	</DemoExample>

	<DemoExample
		title="Ctrl+wheel zooms at the cursor, and only because you asked for it"
		note="`pinch` needs two fingers, so on a laptop it never fires. `.wheel` is the opt-in that attaches a wheel listener, and it recognizes Ctrl+wheel only — the browser's own page zoom, which is the one gesture worth claiming. `.prevent` attaches the listener non-passive so the surface can take that zoom instead of the page. A plain wheel is left alone, so the page still scrolls."
		code={WHEEL_CODE}
	>
		<div
			x-data="{
				zoom: 1,
				base: 1,
				ox: 50,
				oy: 50,
				handleWheel(d) {
					const r = this.$refs.frame.getBoundingClientRect()
					this.ox = ((d.x - r.left) / r.width) * 100
					this.oy = ((d.y - r.top) / r.height) * 100
				},
			}"
			x-effect="if ($store.gesture.kind === 'wheel') zoom = base * $store.gesture.scale"
			x-effect="if (!$store.gesture.active) base = zoom"
			class="rounded-lg border bg-[var(--ios-bg-secondary)] p-6"
		>
			<p class="text-sm font-medium mb-4">
				Third surface: put the cursor over the box and turn the wheel with
				<kbd>Ctrl</kbd> (<kbd>⌘</kbd> on macOS) held. The point under the
				cursor is the point that stays put. Turn the wheel without the
				modifier and the page just scrolls, exactly as it does anywhere
				else on it.
			</p>

			<div
				x-ref="surface"
				x-gesture.wheel.prevent="handleWheel"
				class="flex h-40 touch-none select-none items-center justify-center overflow-hidden rounded-md border-2 border-dashed"
			>
				<div x-ref="frame" class="flex h-24 w-40 items-center justify-center">
					<div
						x-bind:style="{ transform: 'scale(' + zoom + ')', transformOrigin: ox + '% ' + oy + '%' }"
						class="flex h-24 w-40 items-center justify-center rounded-md border bg-[var(--ios-fill-quaternary)] text-xs text-[var(--ios-label-secondary)]"
					>
						<span x-text="'×' + zoom.toFixed(2)"></span>
					</div>
				</div>
			</div>

			<div class="mt-3 flex flex-wrap items-center gap-2">
				<span class="text-sm">
					zoom <span x-text="zoom.toFixed(2)"></span>, anchored at
					<span x-text="ox.toFixed(0)"></span>%<span x-text="oy.toFixed(0)"></span>%
				</span>
			</div>

			<p class="mt-3 text-xs text-[var(--ios-label-secondary)]">
				<code>wheel</code> is opt-in: without the <code>.wheel</code> modifier
				no wheel listener is attached at all, so the package costs an existing
				consumer nothing. <code>.prevent</code> attaches that listener
				non-passive, which is the only way the surface can cancel the
				browser's own Ctrl+wheel zoom — a passive listener cannot cancel
				anything, so without it the page zooms instead of the box. Only
				Ctrl+wheel is recognized: a plain wheel is the user scrolling, so it
				reaches the browser untouched, and a trackpad pinch arrives here
				unchanged because browsers report it as a wheel with
				<code>ctrlKey</code> set. Two details worth copying: the scale
				comes back to <code>1</code> after a session goes idle, which is why
				the zoom you can see is committed into a base rather than read
				straight off the store; and the anchor is measured against the element
				being transformed — the surface here is only where the gesture lives.
			</p>
		</div>
	</DemoExample>
</DemoSection>