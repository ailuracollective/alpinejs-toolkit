---
import { ClientRouter } from "astro:transitions";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import DemoButton from "../components/astro/DemoButton.astro";
import SonnerToasts from "../components/SonnerToasts.astro";
import { REPO_URL } from "../config/urls.js";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Playground · Alpine.js Toolkit",
  description = "Interactive playground for the @ailura Alpine.js toolkit plugins",
} = Astro.props;

/*
 * The demos are the whole app: every route hangs off `/`, so the "Playground"
 * nav link is the site root and is current on every page. There is no
 * `pathname.startsWith(...)` test left to make — it used to distinguish the
 * playground from a non-playground section that no longer exists.
 */
const navLinkClass = (active: boolean) =>
  [
    "rounded-full px-3.5 py-1.5 text-sm font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--ios-blue)]/50 touch-manipulation",
    active
      ? "bg-[var(--ios-blue)] text-white shadow-sm"
      : "text-[var(--ios-label-secondary)] hover:bg-[var(--ios-fill-tertiary)] hover:text-[var(--ios-label)]",
  ].join(" ");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		{/*
			No-flash bootstrap: read the same `theme` key the controller writes and
			set the class before first paint. `color-scheme` is deliberately left
			to the stylesheet (`:root` / `.dark`) — an inline style here would
			outrank the class and go stale the first time the user switches theme.
		*/}
		<script is:inline>
			(function () {
				var key = "theme";
				var saved = localStorage.getItem(key);
				var mode =
					saved === "light" || saved === "dark" || saved === "system" ? saved : "system";
				var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				var resolved = mode === "system" ? (dark ? "dark" : "light") : mode;
				var root = document.documentElement;
				root.classList.remove("light", "dark");
				root.classList.add(resolved);
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.webmanifest" />
		{/*
			iOS ignores the web manifest for Home Screen installs and reads these
			tags instead. Without `apple-mobile-web-app-capable` the site launches
			in a Safari-like chrome, and `display-mode: standalone` never matches —
			so `notify`'s `isStandaloneDisplayMode()` reported false, the adapter
			reported `platform-restricted`, and iOS kept refusing. The "add this
			site to the Home Screen" advice could not actually lead anywhere.
		*/}
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Toolkit" />
		<link rel="apple-touch-icon" href="/logo.svg" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin="anonymous" />
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-[var(--ios-bg-primary)] text-[var(--ios-label)]" x-data="demoShell" x-cloak>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-xl focus:bg-[var(--ios-blue)] focus:px-3 focus:py-2 focus:text-white focus:outline-none"
		>
			Skip to content
		</a>

		<div id="overlay-root" transition:persist></div>

		<div class="flex min-h-screen">
			<slot name="sidebar" />

			<div class="flex min-h-screen min-w-0 flex-1 flex-col overflow-x-clip">
				<header
					class="sticky top-0 z-30 border-b border-[var(--ios-separator)] bg-[var(--ios-bg-primary)]/80 backdrop-blur-xl backdrop-saturate-150 supports-[backdrop-filter]:bg-[var(--ios-bg-primary)]/70 transition-[margin-left] duration-300 motion-reduce:transition-none"
					x-bind:class="$store.media.breakpoint === 'desktop' ? (expanded ? 'ml-64' : 'ml-16') : ''"
					transition:persist
				>
					<div class="flex h-12 items-center gap-3 px-4">
					<DemoButton
						variant="ghost"
						size="icon"
							aria-label="Toggle sidebar"
							class="rounded-full text-[var(--ios-label-secondary)] hover:bg-[var(--ios-fill-tertiary)] hover:text-[var(--ios-label)]"
							x-on:click="$store.media.breakpoint === 'desktop' ? expanded = !expanded : $store.sidebar.toggle()"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="size-5"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</DemoButton>
						<div class="min-w-0 flex-1">
							<p class="truncate text-base font-semibold tracking-tight text-balance">Alpine.js Toolkit</p>
							<p class="truncate text-[11px] leading-tight text-[var(--ios-label-secondary)]">
								@ailura · Interactive plugin demos
							</p>
						</div>
						<nav class="hidden items-center gap-1 sm:flex" aria-label="Site">
							<a href="/" class={navLinkClass(true)} aria-current="page">
								Playground
							</a>
							<a
								href={REPO_URL}
								target="_blank"
								rel="noreferrer"
								class={navLinkClass(false)}
							>
								GitHub
							</a>
						</nav>
					</div>
				</header>

				<div class="fixed top-0 left-0 right-0 z-50 h-[2px] bg-[var(--ios-fill-quaternary)] motion-reduce:hidden" aria-hidden="true">
					<div
						class="h-full bg-[var(--ios-blue)] transition-[width] duration-100 linear motion-reduce:transition-none"
						x-bind:style="'width: ' + $store.scroll.progress + '%'"
					></div>
				</div>

				<slot />

				<SonnerToasts />
			</div>
		</div>

		<script>
			import { startAlpineDemo } from "../alpine-boot";

			await startAlpineDemo();
		</script>
	</body>
</html>
