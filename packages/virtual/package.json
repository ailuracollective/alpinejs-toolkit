{
  "name": "@ailura/alpinejs-virtual",
  "version": "1.0.0",
  "description": "Alpine.js headless virtual list — fixed/variable sizes, overscan, window/element scroll and ARIA helpers on @ailura/alpinejs-core.",
  "keywords": [
    "alpine",
    "alpinejs",
    "headless",
    "plugin",
    "virtual",
    "virtualization"
  ],
  "homepage": "https://github.com/ailuracollective/alpinejs-toolkit#readme",
  "bugs": {
    "url": "https://github.com/ailuracollective/alpinejs-toolkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuracollective/alpinejs-toolkit.git",
    "directory": "packages/virtual"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "devDependencies": {
    "@ailura/alpinejs-testing": "workspace:*",
    "@size-limit/esbuild-why": "^13.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/alpinejs": "3.13.11",
    "alpinejs": "^3.14.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.5.0",
    "vite-plus": "^0.3.0"
  },
  "peerDependencies": {
    "@ailura/alpinejs-core": "workspace:*",
    "alpinejs": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "toolkit": {
    "bundleBudget": {
      "category": "small-feature"
    }
  }
}
